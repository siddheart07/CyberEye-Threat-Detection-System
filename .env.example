# Splunk HTTP Event Collector endpoint
# Local Splunk Enterprise example:
SPLUNK_HEC_URL=http://localhost:8088

# Never place a real token in this example file
SPLUNK_HEC_TOKEN=YOUR_PRIVATE_HEC_TOKEN

# Splunk index used for CyberEye alerts
SPLUNK_INDEX=cybereye

# Set to true when using a trusted HTTPS certificate
SPLUNK_VERIFY_SSL=false